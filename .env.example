# Conexión Mayor — variables de entorno (SERVER ONLY)
# Copiá este archivo a .env para desarrollo local. NUNCA commitees .env
# Estas claves van SOLO en el servidor (Nitro/Cloudflare). No uses VITE_ ni SUPABASE_ — este proyecto usa SB_* a propósito.
# Conseguí los valores en Supabase Dashboard → Project Settings → API

# URL de tu proyecto Supabase (ej: https://abcdefgh.supabase.co)
SB_URL=https://TU_PROJECT_REF.supabase.co

# Clave pública (anon/publishable) — respeta RLS, para lecturas públicas
SB_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICA

# Clave secreta (service_role / sb_secret_) — BYPASA RLS, solo servidor para escrituras
# ⚠️ Nunca la expongas al cliente ni la subas a git. Si la pegaste en un chat, rótala antes de usarla.
SB_SECRET_KEY=sb_secret_TU_CLAVE_SECRETA

# ── Groq — https://console.groq.com/keys (gratis, sin tarjeta) ──────────────
# Vision + LLM para extractor de afiches. Free tier: 30 RPM / 1K RPD, 594 TPS.
# Modelos disponibles (registry en src/server/ai/models.ts):
# - meta-llama/llama-4-scout-17b-16e-instruct (default, recomendado, 128K, 5 imágenes, 594 TPS, $0.11/$0.34)
# - meta-llama/llama-4-maverick-17b-128e-instruct (128K, 5 imágenes, 400B MoE, $0.60/$3.00)
# - meta-llama/llama-3.2-90b-vision-preview (fallback)
# - meta-llama/llama-3.2-11b-vision-preview (ligero)
# BaseURL interno: https://api.groq.com/openai/v1 (OpenAI-compatible). Requiere palabra JSON en prompt para json_object.
GROQ_API_KEY=gsk_...

# Deprecated: ahora se selecciona desde UI (/db → tab Probar IA), esta var solo es fallback
# Si no se elige modelo en la UI, el servidor usa DEFAULT_GROQ_MODEL (scout). No es obligatorio.
# AI_EXTRACTOR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_EXTRACTOR_MODEL_OVERRIDE=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MODEL_OVERRIDE=meta-llama/llama-4-scout-17b-16e-instruct
