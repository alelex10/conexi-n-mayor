# Copy to .env for local dev. NEVER commit .env
# Supabase project URL
SB_URL=https://TU_PROJECT_REF.supabase.co
# Supabase publishable key (RLS-protected reads)
SB_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE_PUBLICA
# Supabase secret key (server-only, bypasses RLS)
SB_SECRET_KEY=sb_secret_TU_CLAVE_SECRETA
# Groq LLM key (server-only)
GROQ_API_KEY=gsk_...
# Tavily live search key, primary (server-only)
TAVILY_API_KEY=tvly-...
# Exa fallback search key, optional (server-only)
# EXA_API_KEY=...
# Serper fallback search key, optional (server-only)
# SERPER_API_KEY=...
